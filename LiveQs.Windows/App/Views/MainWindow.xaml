<Window x:Class="LiveQs.Windows.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="活动时间" Width="1040" Height="720" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0, 0, 1, 0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,2,10,26">
                    <Image Width="36" Height="36"
                           Source="pack://application:,,,/Assets/LiveQs.png"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="8, 0, 0, 0">
                        <TextBlock Text="LIVE QS" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="活动时间" Foreground="{DynamicResource SidebarSecondaryTextBrush}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button x:Name="StatisticsButton" Tag="statistics" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataPie24" FontSize="18" Width="28"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="统计" Style="{DynamicResource NavigationButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TimelineButton" Tag="timeline" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Timeline24" FontSize="18" Width="28"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="时间线" Style="{DynamicResource NavigationButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Tag="settings" Click="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" Width="28"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="设置" Style="{DynamicResource NavigationButtonText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Grid.Row="3" Background="{DynamicResource SidebarStatusBrush}" CornerRadius="5" Padding="11,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SamplingDot" Width="8" Height="8" Fill="{DynamicResource SidebarSamplingActiveBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="SamplingStatusText" Text="采样中" FontSize="12" />
                        </StackPanel>
                        <TextBlock x:Name="SyncStatusText" Text="本地模式" Foreground="{DynamicResource SidebarSecondaryTextBrush}" FontSize="11" Margin="16,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <ContentControl x:Name="PageContent" Grid.Column="1"/>
    </Grid>
    <Window.Resources>
        <Style x:Key="NavigationButtonText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SidebarNavTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource SidebarNavHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SidebarNavHoverTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
