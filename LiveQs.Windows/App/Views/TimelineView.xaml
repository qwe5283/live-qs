<UserControl x:Class="LiveQs.Windows.App.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LiveQs.Windows.App.Converters"
             MinWidth="680" MinHeight="500">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <converters:BooleanToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="28,24,28,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="时间线" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="&#x2039;" FontFamily="Segoe UI" FontSize="18" ToolTip="前一天" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="Previous_Click" />
                <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" Margin="7,0" />
                <Button Content="&#x203A;" FontFamily="Segoe UI" FontSize="18" ToolTip="后一天" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="Next_Click" />
                <Button Content="今天" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Click="Today_Click" />
                <Button Content="查询" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" Click="Query_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Surface}" Margin="28,0,28,28" Padding="0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenFalse}}">
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="20,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="86">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,10,0" HorizontalAlignment="Right" />
                                    <Grid Grid.Column="1">
                                        <Rectangle Width="2" Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Center" />
                                        <Ellipse Width="12" Height="12" Fill="{Binding Color}" Stroke="{DynamicResource SurfaceBrush}"
                                                 StrokeThickness="3" VerticalAlignment="Top" Margin="0,7,0,0" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" Margin="10,3,20,18">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding TimeRange}" Style="{StaticResource MutedText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="10,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="560" />
                                        <TextBlock Text="{Binding Flags}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Duration}" VerticalAlignment="Top" Margin="0,5,6,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="这一天没有活动记录" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" />
                    <TextBlock Text="可以切换日期，或在设置中确认采样未暂停。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
