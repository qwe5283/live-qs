<UserControl x:Class="LiveQs.Windows.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LiveQs.Windows.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinWidth="680" MinHeight="500">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <converters:BooleanToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="28,8,28,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="时间线" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button ToolTip="前一天" AutomationProperties.Name="前一天" Style="{StaticResource SecondaryButton}" Padding="10,6" Command="{Binding PreviousCommand}">
                    <ui:SymbolIcon Symbol="ChevronLeft20" FontSize="18"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" Margin="7,0" />
                <Button ToolTip="后一天" AutomationProperties.Name="后一天" Style="{StaticResource SecondaryButton}" Padding="10,6" Command="{Binding NextCommand}">
                    <ui:SymbolIcon Symbol="ChevronRight20" FontSize="18"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Content="今天" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding TodayCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" Command="{Binding LoadCommand}"><TextBlock Text="查询" Style="{StaticResource ButtonContentText}" /></Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Surface}" Margin="28,0,28,28" Padding="0">
            <Grid>
                <ListBox x:Name="TimelineList"
                         ItemsSource="{Binding Rows}"
                         Margin="20,16"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.ScrollChanged="TimelineList_ScrollChanged"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenFalse}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="86">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,10,0" HorizontalAlignment="Right" />
                                    <Grid Grid.Column="1">
                                        <Rectangle Width="2" Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Center" />
                                        <Ellipse Width="12" Height="12" Fill="{Binding Color}" Stroke="{DynamicResource SurfaceBrush}"
                                                 StrokeThickness="3" VerticalAlignment="Top" Margin="0,7,0,0" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" Margin="10,3,20,18">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding TimeRange}" Style="{StaticResource MutedText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="10,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="560" />
                                        <TextBlock Text="{Binding Flags}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Duration}" VerticalAlignment="Top" Margin="0,5,6,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}">
                    <ui:SymbolIcon Symbol="CalendarEmpty24" FontSize="34" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="这一天没有活动记录" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="可以切换日期，或在设置中确认采样未暂停" Style="{StaticResource MutedText}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <Border Background="{DynamicResource SurfaceBrush}"
                        Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhenTrue}}"
                        Panel.ZIndex="2">
                    <ui:ProgressRing Width="36" Height="36" IsIndeterminate="True"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,14,14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding IsLoadingMore, Converter={StaticResource VisibleWhenTrue}}"
                        Panel.ZIndex="3">
                    <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
