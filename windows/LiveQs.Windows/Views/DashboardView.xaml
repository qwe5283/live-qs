<UserControl x:Class="LiveQs.Windows.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LiveQs.Windows.Controls"
             xmlns:converters="clr-namespace:LiveQs.Windows.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinWidth="720" MinHeight="520">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <converters:BooleanToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />
        <converters:DurationConverter x:Key="DurationText" />
        <converters:SharePercentConverter x:Key="SharePercent" />
        <converters:ShareTextConverter x:Key="ShareText" />
        <converters:ApplicationIconConverter x:Key="ApplicationIcon" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="28,8,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="统计" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding RangeText}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="今天" Style="{StaticResource SecondaryButton}" Padding="11,7" Margin="0,0,6,0" Command="{Binding TodayCommand}" />
                <Button Content="近 7 天" Style="{StaticResource SecondaryButton}" Padding="11,7" Margin="0,0,6,0" Command="{Binding WeekCommand}" />
                <Button Content="近 30 天" Style="{StaticResource SecondaryButton}" Padding="11,7" Margin="0,0,10,0" Command="{Binding MonthCommand}" />
                <DatePicker SelectedDate="{Binding StartDate}" Width="160" />
                <TextBlock Text="至" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="7,0" />
                <DatePicker SelectedDate="{Binding EndDate}" Width="160" />
                <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Command="{Binding LoadCommand}"><TextBlock Text="查询" Style="{StaticResource ButtonContentText}" /></Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,0,28,28">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Surface}" Padding="18,15">
                        <StackPanel>
                            <TextBlock Text="活跃时间" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding ActiveText}" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Surface}" Padding="18,15">
                        <StackPanel>
                            <TextBlock Text="离开时间" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding AfkText}" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Surface}" Padding="18,15">
                        <StackPanel>
                            <TextBlock Text="使用应用" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding AppCountText}" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenFalse}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Surface}" Padding="20" MinHeight="390">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="活跃时间占比" Style="{StaticResource SectionTitle}" />
                            <TextBlock Grid.Row="1" Text="{Binding DistributionText}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            <ScrollViewer Grid.Row="2" Margin="0,14,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <controls:ActiveTimeChart ItemsSource="{Binding ActiveBuckets}" IsHourly="{Binding IsHourlyDistribution}"
                                                          BarBrush="{DynamicResource AccentBrush}" TextBrush="{DynamicResource SecondaryTextBrush}"
                                                          GridBrush="{DynamicResource BorderBrush}" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Surface}" Padding="20" MinHeight="390">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="应用时间占比" Style="{StaticResource SectionTitle}" />
                            <Grid Grid.Row="1" Margin="20">
                                <controls:DonutChart x:Name="ApplicationShareChart" ItemsSource="{Binding TopApps}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="总计" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveText}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="2">
                                <ItemsControl ItemsSource="{Binding TopApps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,12,3">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding AppName}" Margin="5,0,0,0" FontSize="12" MaxWidth="90" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,3,12,3">
                                    <Ellipse Width="8" Height="8" Fill="{Binding TrackBrush, ElementName=ApplicationShareChart}" VerticalAlignment="Center" />
                                    <TextBlock Text="其他" Margin="5,0,0,0" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Surface}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="应用排行" Style="{StaticResource SectionTitle}" />
                            <ItemsControl Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding Apps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="20" Height="20" Source="{Binding ExecutablePath, Converter={StaticResource ApplicationIcon}}"
                                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="230" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Duration, Converter={StaticResource DurationText}}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Share, Converter={StaticResource ShareText}}" HorizontalAlignment="Right" />
                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Maximum="100" Value="{Binding Share, Converter={StaticResource SharePercent}}"
                                                         Foreground="{Binding Color}" Background="{DynamicResource BorderBrush}" BorderThickness="0" Height="6" Margin="0,8,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Surface}" Padding="40" MinHeight="260"
                        Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="DataPie24" FontSize="34" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="这个日期范围还没有活动数据" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" />
                        <TextBlock Text="后台采样开启后，统计会自动出现在这里。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
