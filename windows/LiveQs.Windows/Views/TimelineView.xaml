<UserControl x:Class="LiveQs.Windows.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LiveQs.Windows.Controls"
             xmlns:converters="clr-namespace:LiveQs.Windows.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinWidth="640" MinHeight="500">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <converters:BooleanToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />
        <DataTemplate x:Key="RawRecordsTemplate">
            <StackPanel Margin="0,10,0,0">
                <WrapPanel>
                    <TextBlock Text="查看时段" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                              DisplayMemberPath="Label" Width="250" AutomationProperties.Name="原始记录时间选区" />
                </WrapPanel>
                <TextBlock Text="{Binding RawSummary}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,6" />
                <ItemsControl ItemsSource="{Binding RawRecords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{Binding TimeRange}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Flags}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource MutedText}" FontSize="12" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="EpisodeDetailsTemplate">
            <StackPanel Margin="0,16,0,0">
                <StackPanel Visibility="{Binding HasActiveApplications, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock Text="前台应用轨迹 · 点击色块查看该时段记录" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Applications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
                                    <controls:TimelineTrack Grid.Column="1" ItemsSource="{Binding Marks}" Height="16"
                                                           TrackBrush="{DynamicResource WindowBrush}" SelectionBrush="{DynamicResource AccentBrush}"
                                                           SelectionStart="{Binding DataContext.SelectionStart, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           SelectionEnd="{Binding DataContext.SelectionEnd, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           SelectPositionCommand="{Binding DataContext.SelectPositionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           AutomationProperties.Name="{Binding Name}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="94,4,80,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StartTime}" Style="{StaticResource MutedText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding MiddleTime}" Style="{StaticResource MutedText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding EndTime}" Style="{StaticResource MutedText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
                <Button Command="{Binding ToggleRawRecordsCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        AutomationProperties.Name="展开或收起原始记录">
                    <TextBlock>
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ButtonContentText}"><Setter Property="Text" Value="查看原始记录" /><Style.Triggers><DataTrigger Binding="{Binding IsRawExpanded}" Value="True"><Setter Property="Text" Value="收起原始记录" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Button>
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsRawExpanded}" Value="True"><Setter Property="Content" Value="{Binding}" /><Setter Property="ContentTemplate" Value="{StaticResource RawRecordsTemplate}" /><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="28,8,28,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="时间线" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,12,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button ToolTip="前一天" AutomationProperties.Name="前一天" Style="{StaticResource SecondaryButton}" Padding="10,6" Command="{Binding PreviousCommand}">
                    <ui:SymbolIcon Symbol="ChevronLeft20" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <DatePicker SelectedDate="{Binding SelectedDate}" SelectedDateFormat="Short" Width="135" Margin="7,0" />
                <Button ToolTip="后一天" AutomationProperties.Name="后一天" Style="{StaticResource SecondaryButton}" Padding="10,6" Command="{Binding NextCommand}">
                    <ui:SymbolIcon Symbol="ChevronRight20" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Content="今天" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding TodayCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" Command="{Binding LoadCommand}"><TextBlock Text="查询" Style="{StaticResource ButtonContentText}" /></Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Surface}" Margin="28,0,28,28" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ListBox x:Name="TimelineList" ItemsSource="{Binding Rows}" Margin="18,10" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="TimelineList_ScrollChanged"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenFalse}}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,16" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,2,10,0">
                                        <TextBlock Text="{Binding EndTime}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding StartTime}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="10,6" VerticalAlignment="Top"
                                                    Command="{Binding ToggleExpandedCommand}" AutomationProperties.Name="展开或收起活动轨迹"
                                                    Visibility="{Binding HasDetails, Converter={StaticResource VisibleWhenTrue}}">
                                                <TextBlock>
                                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ButtonContentText}"><Setter Property="Text" Value="展开轨迹" /><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Text" Value="收起轨迹" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding TimeRange}" ToolTip="{Binding Coverage}" Style="{StaticResource MutedText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,6,0,0" />
                                        <StackPanel Visibility="{Binding HasActiveApplications, Converter={StaticResource VisibleWhenTrue}}">
                                            <controls:TimelineTrack ItemsSource="{Binding Marks}" Height="8" Margin="0,12,0,6" TrackBrush="{DynamicResource WindowBrush}"
                                                                   SelectPositionCommand="{Binding SelectPositionCommand}" AutomationProperties.Name="应用切换预览，点击查看该时段" />
                                            <ItemsControl ItemsSource="{Binding Applications}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,4,15,0"><Rectangle Width="8" Height="8" Fill="{Binding Color}" RadiusX="2" RadiusY="2" Margin="0,0,5,0" /><TextBlock Text="{Binding Name}" FontSize="11" /><TextBlock Text="{Binding Duration}" Style="{StaticResource MutedText}" FontSize="11" Margin="5,0,0,0" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Changes}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" Visibility="{Binding HasChanges, Converter={StaticResource VisibleWhenTrue}}" />
                                        <TextBlock Text="{Binding Flags}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" Visibility="{Binding HasFlags, Converter={StaticResource VisibleWhenTrue}}" />
                                        <TextBlock Text="{Binding Coverage}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" Visibility="{Binding HasCoverageDifference, Converter={StaticResource VisibleWhenTrue}}" />
                                        <TextBlock Text="此段仍有更早记录待加载" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,6,0,0" Visibility="{Binding IsPartial, Converter={StaticResource VisibleWhenTrue}}" />
                                        <ContentControl>
                                            <ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Content" Value="{Binding}" /><Setter Property="ContentTemplate" Value="{StaticResource EpisodeDetailsTemplate}" /><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ContentControl.Style>
                                        </ContentControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="1" Content="加载更早记录" Command="{Binding LoadMoreCommand}" Style="{StaticResource SecondaryButton}"
                        Margin="18,0,18,12" HorizontalAlignment="Center" Visibility="{Binding HasMore, Converter={StaticResource VisibleWhenTrue}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}">
                    <ui:SymbolIcon Symbol="CalendarEmpty24" FontSize="34" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="这一天没有活动记录" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="可以切换日期，或在设置中确认采样未暂停" Style="{StaticResource MutedText}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
                <Border Grid.RowSpan="2" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhenTrue}}" Panel.ZIndex="2">
                    <ui:ProgressRing Width="36" Height="36" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.RowSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10" Margin="0,0,14,14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Visibility="{Binding IsLoadingMore, Converter={StaticResource VisibleWhenTrue}}" Panel.ZIndex="3">
                    <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
