<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LiveQs.Windows.Controls"
    xmlns:converters="clr-namespace:LiveQs.Windows.Converters"
    xmlns:viewModels="clr-namespace:LiveQs.Windows.ViewModels"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="LiveQs.Windows.Views.TimelineView"
    MinWidth="640"
    MinHeight="500">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <converters:BooleanToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />
        <converters:ApplicationIconConverter x:Key="ApplicationIcon" />
        <ControlTemplate x:Key="TimelineScrollViewerTemplate" TargetType="ScrollViewer">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <ScrollContentPresenter
                    x:Name="PART_ScrollContentPresenter"
                    CanContentScroll="{TemplateBinding CanContentScroll}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                <ScrollBar
                    x:Name="PART_VerticalScrollBar"
                    Grid.Column="1"
                    Orientation="Vertical"
                    Width="12"
                    Margin="0,0,3,0"
                    HorizontalAlignment="Right"
                    Maximum="{TemplateBinding ScrollableHeight}"
                    ViewportSize="{TemplateBinding ViewportHeight}"
                    Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                    AutomationProperties.Name="时间线滚动条" />
            </Grid>
        </ControlTemplate>
        <DataTemplate x:Key="RawRecordsTemplate">
            <StackPanel Margin="0,10,0,0">
                <WrapPanel>
                    <TextBlock
                        Text="查看时段"
                        Style="{StaticResource MutedText}"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0" />
                    <ComboBox
                        ItemsSource="{Binding Windows}"
                        SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                        DisplayMemberPath="Label"
                        Width="250"
                        AutomationProperties.Name="原始记录时间选区" />
                </WrapPanel>
                <TextBlock
                    Text="{Binding RawSummary}"
                    Style="{StaticResource MutedText}"
                    FontSize="11"
                    Margin="0,10,0,6" />
                <ItemsControl ItemsSource="{Binding RawRecords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock
                                            Text="{Binding TimeRange}"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="11"
                                            Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" Margin="0,3,0,0" />
                                        <TextBlock
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource MutedText}"
                                            Margin="0,3,0,0" />
                                        <TextBlock
                                            Text="{Binding Flags}"
                                            Foreground="{DynamicResource MutedTextBrush}"
                                            FontSize="11"
                                            Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Duration}"
                                        Style="{StaticResource MutedText}"
                                        FontSize="12" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="EpisodeDetailsTemplate">
            <StackPanel Margin="0,16,0,0">
                <StackPanel Visibility="{Binding HasActiveApplications, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock
                        Text="前台应用轨迹 · 点击色块查看该时段记录"
                        Style="{StaticResource MutedText}"
                        FontSize="12"
                        Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Applications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Name}"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Margin="0,0,8,0" />
                                    <controls:TimelineTrack
                                        Grid.Column="1"
                                        ItemsSource="{Binding Marks}"
                                        Height="16"
                                        TrackBrush="{DynamicResource WindowBrush}"
                                        SelectionBrush="{DynamicResource AccentBrush}"
                                        SelectionStart="{Binding DataContext.SelectionStart, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        SelectionEnd="{Binding DataContext.SelectionEnd, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        SelectPositionCommand="{Binding DataContext.SelectPositionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        AutomationProperties.Name="{Binding Name}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding Duration}"
                                        Style="{StaticResource MutedText}"
                                        FontSize="11"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="94,4,80,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{Binding StartTime}"
                            Style="{StaticResource MutedText}"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="11" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding MiddleTime}"
                            Style="{StaticResource MutedText}"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="11"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding EndTime}"
                            Style="{StaticResource MutedText}"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="11"
                            HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
                <Button
                    Command="{Binding ToggleRawRecordsCommand}"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="展开或收起原始记录">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonContentText}">
                                <Setter Property="Text" Value="查看原始记录" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRawExpanded}" Value="True">
                                        <Setter Property="Text" Value="收起原始记录" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRawExpanded}" Value="True">
                                    <Setter Property="Content" Value="{Binding}" />
                                    <Setter Property="ContentTemplate" Value="{StaticResource RawRecordsTemplate}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="28,8,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="时间线" Style="{StaticResource PageTitle}" />
                <TextBlock
                    Text="{Binding Summary}"
                    Style="{StaticResource MutedText}"
                    FontSize="12"
                    Margin="0,5,12,0"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    ToolTip="前一天"
                    AutomationProperties.Name="前一天"
                    Style="{StaticResource SecondaryButton}"
                    Padding="10,6"
                    Command="{Binding PreviousCommand}">
                    <ui:SymbolIcon
                        Symbol="ChevronLeft20"
                        FontSize="18"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <DatePicker SelectedDate="{Binding SelectedDate}" SelectedDateFormat="Short" Width="135" Margin="7,0" />
                <Button
                    ToolTip="后一天"
                    AutomationProperties.Name="后一天"
                    Style="{StaticResource SecondaryButton}"
                    Padding="10,6"
                    Command="{Binding NextCommand}">
                    <ui:SymbolIcon
                        Symbol="ChevronRight20"
                        FontSize="18"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button
                    Content="今天"
                    Style="{StaticResource SecondaryButton}"
                    Margin="7,0,0,0"
                    Command="{Binding TodayCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" Command="{Binding LoadCommand}">
                    <TextBlock Text="查询" Style="{StaticResource ButtonContentText}" />
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="28,0,0,28">
            <ListBox
                x:Name="TimelineList"
                ItemsSource="{Binding ListItems}"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.ScrollChanged="OnTimelineScrollChanged"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.ScrollUnit="Pixel"
                Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenFalse}}">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer
                            x:Name="PART_ScrollViewer"
                            Focusable="False"
                            Template="{StaticResource TimelineScrollViewerTemplate}"
                            CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type viewModels:TimelineEpisodeViewModel}">
                        <Grid Margin="2,0,0,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,16,6,28">
                                <TextBlock
                                    Text="{Binding EndTime}"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    Style="{StaticResource MutedText}"
                                    VerticalAlignment="Top" />
                                <TextBlock
                                    Text="{Binding StartTime}"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="11"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    VerticalAlignment="Bottom" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="0,0,12,0" IsHitTestVisible="False">
                                <Border
                                    Width="2"
                                    Background="{DynamicResource BorderBrush}"
                                    HorizontalAlignment="Center" />
                                <Border
                                    Width="2"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,24,0,36"
                                    HorizontalAlignment="Center"
                                    Opacity="0.5" />
                                <Ellipse
                                    Width="12"
                                    Height="12"
                                    Fill="{DynamicResource AccentBrush}"
                                    Stroke="{DynamicResource SurfaceBrush}"
                                    StrokeThickness="2"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0" />
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Fill="{DynamicResource SurfaceBrush}"
                                    Stroke="{DynamicResource AccentBrush}"
                                    StrokeThickness="2"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,32" />
                            </Grid>
                            <Border
                                x:Name="EpisodeCard"
                                Grid.Column="2"
                                Style="{StaticResource Surface}"
                                Margin="0,0,0,12"
                                Padding="18,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                    <ui:SymbolIcon
                                                        Symbol="{Binding TitleSymbol}"
                                                        Filled="False"
                                                        FontSize="20"
                                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding HasApplicationIcon, Converter={StaticResource VisibleWhenFalse}}" />
                                                    <Image
                                                        Width="20"
                                                        Height="20"
                                                        Source="{Binding ExecutablePath, Converter={StaticResource ApplicationIcon}}"
                                                        VerticalAlignment="Center"
                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                        Visibility="{Binding HasApplicationIcon, Converter={StaticResource VisibleWhenTrue}}" />
                                                </Grid>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding Title}"
                                                    FontWeight="SemiBold"
                                                    FontSize="14"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <TextBlock
                                                Text="{Binding Summary}"
                                                Style="{StaticResource MutedText}"
                                                FontSize="12"
                                                Margin="0,4,0,0"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,6"
                                            VerticalAlignment="Top"
                                            Command="{Binding ToggleExpandedCommand}"
                                            AutomationProperties.Name="展开或收起活动轨迹"
                                            Visibility="{Binding HasDetails, Converter={StaticResource VisibleWhenTrue}}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style
                                                        TargetType="TextBlock"
                                                        BasedOn="{StaticResource ButtonContentText}">
                                                        <Setter Property="Text" Value="展开轨迹" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Text" Value="收起轨迹" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        Text="{Binding TimeRange}"
                                        ToolTip="{Binding Coverage}"
                                        Style="{StaticResource MutedText}"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="11"
                                        Margin="0,6,0,0" />
                                    <StackPanel
                                        Visibility="{Binding HasActiveApplications, Converter={StaticResource VisibleWhenTrue}}">
                                        <controls:TimelineTrack
                                            ItemsSource="{Binding Marks}"
                                            Height="8"
                                            Margin="0,12,0,6"
                                            TrackBrush="{DynamicResource WindowBrush}"
                                            SelectPositionCommand="{Binding SelectPositionCommand}"
                                            AutomationProperties.Name="应用切换预览，点击查看该时段" />
                                        <ItemsControl ItemsSource="{Binding Applications}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,15,0">
                                                        <Rectangle
                                                            Width="8"
                                                            Height="8"
                                                            Fill="{Binding Color}"
                                                            RadiusX="2"
                                                            RadiusY="2"
                                                            Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding Name}" FontSize="11" />
                                                        <TextBlock
                                                            Text="{Binding Duration}"
                                                            Style="{StaticResource MutedText}"
                                                            FontSize="11"
                                                            Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock
                                        Text="{Binding Changes}"
                                        Style="{StaticResource MutedText}"
                                        FontSize="11"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding HasChanges, Converter={StaticResource VisibleWhenTrue}}" />
                                    <TextBlock
                                        Text="{Binding Flags}"
                                        Foreground="{DynamicResource MutedTextBrush}"
                                        FontSize="11"
                                        Margin="0,4,0,0"
                                        Visibility="{Binding HasFlags, Converter={StaticResource VisibleWhenTrue}}" />
                                    <TextBlock
                                        Text="{Binding Coverage}"
                                        Foreground="{DynamicResource MutedTextBrush}"
                                        FontSize="11"
                                        Margin="0,4,0,0"
                                        Visibility="{Binding HasCoverageDifference, Converter={StaticResource VisibleWhenTrue}}" />
                                    <TextBlock
                                        Text="此段仍有更早记录待加载"
                                        Foreground="{DynamicResource AccentBrush}"
                                        FontSize="11"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding IsPartial, Converter={StaticResource VisibleWhenTrue}}" />
                                    <ContentControl>
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Content" Value="{Binding}" />
                                                        <Setter
                                                            Property="ContentTemplate"
                                                            Value="{StaticResource EpisodeDetailsTemplate}" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type viewModels:TimelineViewModel}">
                        <StackPanel Margin="76,4,0,16" HorizontalAlignment="Center" AutomationProperties.Name="时间线分页状态">
                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsLoadingMore, Converter={StaticResource VisibleWhenTrue}}">
                                <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" />
                                <TextBlock Text="正在加载更早记录…" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock
                                Text="更早记录加载失败，已加载的内容仍可查看"
                                Style="{StaticResource MutedText}"
                                TextWrapping="Wrap"
                                Margin="0,0,0,8"
                                Visibility="{Binding HasLoadMoreError, Converter={StaticResource VisibleWhenTrue}}" />
                            <Button
                                Command="{Binding LoadMoreCommand}"
                                HorizontalAlignment="Center"
                                Visibility="{Binding CanLoadMore, Converter={StaticResource VisibleWhenTrue}}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource ButtonContentText}" />
                                    </DataTemplate>
                                </Button.ContentTemplate>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Content" Value="加载更早记录" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                        <Setter Property="Padding" Value="12,6" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLoadMoreError}" Value="True">
                                                <Setter Property="Content" Value="重试" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock
                                Text="已显示当天全部记录"
                                Style="{StaticResource MutedText}"
                                FontSize="12"
                                Visibility="{Binding HasMore, Converter={StaticResource VisibleWhenFalse}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>
            <Border
                Style="{StaticResource Surface}"
                Margin="0,0,28,0"
                Padding="28"
                Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Symbol="CalendarEmpty24"
                        FontSize="34"
                        Foreground="{DynamicResource MutedTextBrush}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="这一天没有活动记录"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="可以切换日期，或在设置中确认采样未暂停"
                        Style="{StaticResource MutedText}"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border
                Style="{StaticResource Surface}"
                Margin="0,0,28,0"
                Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhenTrue}}"
                Panel.ZIndex="2">
                <ui:ProgressRing
                    Width="36"
                    Height="36"
                    IsIndeterminate="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <Border
                Style="{StaticResource Surface}"
                Margin="0,0,28,0"
                Visibility="{Binding HasQueryError, Converter={StaticResource VisibleWhenTrue}}"
                Panel.ZIndex="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="活动记录查询失败" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="请重试，或在设置中检查本地数据库状态" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    <Button
                        Content="重试"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Center"
                        Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
