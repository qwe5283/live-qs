{
  "name": "@live-qs/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint:openapi": "redocly lint openapi.yaml",
    "test:schemas": "node --test",
