{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live-qs.local/contracts/schemas/events/activity.interval.v1.schema.json",
  "title": "Activity Interval Event V1",
  "description": "A privacy-minimized foreground or AFK interval produced by a device collector.",
  "allOf": [
    {
      "$ref": "../event-envelope.v1.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "event_type": {
      "const": "activity.interval"
    },
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "record_id"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "privacy_level": {
      "type": "string",
      "enum": ["normal", "sensitive"],
      "default": "normal"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_id", "is_afk", "duration"],
      "properties": {
        "application_id": {
          "type": "string",
          "minLength": 1,
          "description": "Executable name or Android package name; never a full executable path."
        },
        "application_label": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "description": "Approved semantic subject identifier, when classification produced one."
        },
        "is_afk": {
          "type": "boolean"
        },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "unit": {
              "$ref": "#/$defs/DurationUnit"
            }
          }
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule_id", "rule_version", "confidence"],
          "properties": {
            "rule_id": {
              "type": "string",
              "minLength": 1
            },
            "rule_version": {
              "type": "integer",
              "minimum": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "finalization_state": {
        "const": "final"
      }
    },
    "required": ["finalization_state"]
  },
  "then": {
    "properties": {
      "end_at": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$"
      }
    },
    "required": ["end_at"]
  },
  "$defs": {
    "SourceKind": {
      "title": "Source Kind",
      "type": "string",
      "enum": ["windows.foreground", "android.accessibility"]
    },
    "DurationUnit": {
      "title": "Duration Unit",
      "const": "ms"
    }
  },
  "unevaluatedProperties": false
}
